# Copy to .env.local (git-ignored). Never commit real values.

# Supabase project (shared with emi_crafting). Used by the API and the worker.
# SUPABASE_SECRET_KEY is server-only: never put it in a VITE_* variable or in browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# External image-to-3D endpoint (same service emi_crafting uses).
SF3D_API_URL=https://ahmad-sarmad-ali-3d-model-ai.hf.space/generate-3d/

# Signs model download URLs (at least 32 random bytes).
MODEL_URL_SECRET=
# Salts the IP hash used for rate limiting. The raw IP is never stored.
IP_HASH_SALT=

# Worker only (npm run worker). Optional.
# WORKER_ID labels the claimed rows; defaults to the hostname.
# POLL_SECONDS is the idle sleep between claims; defaults to 5.
WORKER_ID=
POLL_SECONDS=5
