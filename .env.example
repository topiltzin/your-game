# Copy to .env.local (git-ignored). Never commit real values.
# Neon Postgres (Vercel Marketplace) and Cloudflare R2 (private bucket, S3-compatible API).
DATABASE_URL=
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# External image-to-3D endpoint (same service emi_crafting uses).
SF3D_API_URL=https://ahmad-sarmad-ali-3d-model-ai.hf.space/generate-3d/
# Signs model download URLs (at least 32 random bytes).
MODEL_URL_SECRET=
# Salts the IP hash used for rate limiting. The raw IP is never stored.
IP_HASH_SALT=
