{
  "name": "sketch-runner",
  "version": "0.1.0",
  "description": "Sketch Runner: draw a character, see it in 3D, run",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "db:migrate": "node --experimental-strip-types db/migrate.ts",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/functions": "^3.11.3",
    "heic-to": "^1.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
